{
  "name": "benlk/cota-reroutes-page-rss",
  "description": "Scrape cota.com/reroutes to find new things.",
  "type": "project",
  "license": "CC0-1.0",
  "autoload": {
    "psr-4": {
      "Benlk\\CotaReroutesPageRss\\": "src/",
      "Cota\\": "src/"
    }
  },
  "authors": [
    {
      "name": "Ben Keith",
      "email": "ben@benlk.com"
    }
  ],
  "require": {
    "php": "^8.5",
    "ext-dom": "*",
    "ext-mbstring": "*",
    "guzzlehttp/guzzle": "^7.9",
    "league/commonmark": "^2.7",
    "opis/json-schema": "^2.4",
    "symfony/html-sanitizer": "^7.4"
  },
  "require-dev": {
    "10up/phpcs-composer": "^3.0"
  },
  "scripts": {
    "scrape": "@php scrape.php",
    "feed": "@php feed.php",
    "build": [
      "mkdir -p _site",
      "@php index.php > _site/index.html",
      "cp style.css data/feed.xml _site/"
    ],
    "test": "@php tests/run.php",
	"lint": [
		"phpcs -s ."		],
	"lint-fix": [
		"phpcbf ."
	],
	"lint-changed": [
		"phpcs $(git diff --name-only --diff-filter=ACMRU HEAD | grep \\.php$)"
	]
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
